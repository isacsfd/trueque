{
  "name": "iub-intercambio-libros",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:postgres": "node scripts/p0-postgres.mjs",
    "audit:0011:postgres": "node scripts/audit-0011-postgres.mjs",
    "test:admins:provision": "node scripts/provision-test-admins.mjs",
    "staging:check": "node scripts/staging-check.mjs",
    "inventory:import": "python scripts/import-inventory.py",
    "inventory:import:apply": "python scripts/import-inventory.py --apply",
    "inventory:verify": "python scripts/verify-inventory-import.py",
    "inventory:reconciliation": "python scripts/generate-inventory-reconciliation.py",
    "inventory:reconciliation:verify": "python scripts/verify-reconciliation-workbook.py",
    "inventory:reconciliation:verify-source": "python scripts/verify-reconciliation-source.py",
    "inventory:reconciliation:process": "python scripts/process-inventory-reconciliation.py",
    "inventory:reconciliation:test": "python scripts/tests/test_process_inventory_reconciliation.py",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "db:schema:inspect": "node scripts/inspect-neon-schema.mjs",
    "db:migrate:plan": "node scripts/migrate.mjs",
    "db:migrate:apply": "node scripts/migrate.mjs --apply"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "pg": "^8.23.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.4",
    "vitest": "^5.0.5"
  }
}
