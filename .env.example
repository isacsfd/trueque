# Variables de servidor. No usar prefijo VITE_ ni incluir valores reales aquí.
# URL pooled de Neon para el runtime de funciones públicas; rol iub_public_runtime.
DATABASE_URL=

# URL pooled separada para funciones administrativas; rol iub_admin_runtime.
DATABASE_ADMIN_URL=

# Token aleatorio de al menos 32 caracteres para el diagnóstico privado.
# Secreto exclusivo de Netlify Functions; el endpoint falla cerrado si falta.
DATABASE_DIAGNOSTICS_TOKEN=

# Usuario de migración con DDL; solo en el entorno protegido que ejecute migraciones.
# No configurar en funciones de Netlify ni reutilizar un usuario runtime.
DATABASE_MIGRATION_URL=

# Nombre esperado de la sesión PostgreSQL de migraciones; no es una contraseña.
DATABASE_MIGRATION_ROLE=iub_schema_migrator

# Driver del runner: neon (por defecto) o pg solo para PostgreSQL local/desechable.
DATABASE_MIGRATION_DRIVER=neon

# Usuarios administrativos: JSON privado con username, passwordHash y actorUserId.
# Generar el hash con: npm run admin:hash-password
ADMIN_USERS=

# Secreto de firma de sesión administrativa, al menos 32 bytes.
SESSION_SECRET=

# Claves privadas de cifrado/HMAC de datos de participantes (base64 de 32 bytes).
# No exponerlas en el frontend ni en variables VITE_.
PARTICIPANT_DATA_KEY=
PARTICIPANT_IDENTITY_HMAC_KEY=
PARTICIPANT_DATA_KEY_VERSION=1
PARTICIPANT_HMAC_KEY_VERSION=1

# Versión aprobada del aviso de privacidad ya insertada en privacy_notices.
PRIVACY_NOTICE_VERSION=

# Driver de almacenamiento privado: local | simulated | r2 | s3 | gcs | blobs.
# local solo desarrollo; simulated solo pruebas. Los proveedores reales NO están
# implementados: requieren cuenta, bucket, credenciales y D-13 aprobada.
# En Netlify Functions, local/simulated fallan de forma cerrada; configurar un
# adaptador privado aprobado antes de habilitar cargas. No usar rutas públicas.
PRIVATE_STORAGE_DRIVER=local

# Directorio privado del adaptador local de evidencias (solo desarrollo/pruebas).
# En Netlify no es almacenamiento duradero.
EVIDENCE_STORAGE_DIR=

# Directorio privado del adaptador local de lotes; no usar en Netlify.
BATCH_STORAGE_DIR=

# Retención y limpieza. 0 = no borrar automáticamente (D-14/D-16 pendientes).
# STORAGE_ORPHAN_GRACE_DAYS: días antes de considerar huérfano un objeto.
STORAGE_ORPHAN_GRACE_DAYS=1
EVIDENCE_RETENTION_DAYS=0
BATCH_RETENTION_DAYS=0

# El endpoint antiguo /api/requests sin fotografías está cerrado por defecto.
# Habilitarlo solo para una migración/ventana de compatibilidad aprobada.
ALLOW_LEGACY_REQUEST_INTAKE=false

# Rate limiting de login: best-effort por instancia (no distribuido).
# En produccion se requiere ademas limite en borde/WAF o proveedor de identidad.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_IP_MAX_ATTEMPTS=60
