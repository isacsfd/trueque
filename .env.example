# Variables de servidor. No usar prefijo VITE_ ni incluir valores reales aquí.
# URL de Neon con usuario de aplicación de privilegios mínimos (solo Netlify Functions).
DATABASE_URL=

# Token aleatorio de al menos 32 caracteres para el diagnóstico privado.
# Secreto exclusivo de Netlify Functions; el endpoint falla cerrado si falta.
DATABASE_DIAGNOSTICS_TOKEN=

# Usuario de migración con DDL; solo en el entorno protegido que ejecute migraciones.
# No configurar en funciones de Netlify ni reutilizar el usuario de aplicación.
DATABASE_MIGRATION_URL=
